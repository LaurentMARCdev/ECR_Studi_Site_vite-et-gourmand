# ═══════════════════════════════════════════════════════════════
# Configuration de l'environnement — Vite & Gourmand API
# ═══════════════════════════════════════════════════════════════
# Ce fichier définit les VALEURS PAR DÉFAUT, surchargées dans .env.local
# AUCUNE VALEUR RÉELLE NE DOIT ÊTRE COMMITÉE DANS CE FICHIER.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme-generate-with-php-r-and-set-in-env-local
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URI pour la génération d'URL en contexte non-HTTP (CLI)
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format : postgresql://USER:PASS@HOST:PORT/DBNAME?serverVersion=X&charset=utf8
DATABASE_URL="postgresql://changeme:changeme@127.0.0.1:5432/vitegourmand?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> mongodb ###
# Base NoSQL pour les statistiques admin
MONGODB_URL="mongodb://changeme:changeme@127.0.0.1:27017/?authSource=admin"
MONGODB_DB=vitegourmand_stats
###< mongodb ###

###> symfony/mailer ###
# En dev : null:// pour désactiver, Mailtrap/Mailhog pour tester
# En prod : smtp://user:pass@smtp.example.com:port ou DSN d'un service
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Vite & Gourmand"
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> Front-end et contact ###
FRONTEND_URL=http://localhost:8080
CONTACT_EMAIL=contact@example.com
###< Front-end et contact ###

###> Sécurité cookies ###
# true en prod (HTTPS obligatoire), false en dev local
COOKIE_SECURE=false
# 'strict' si front sur même domaine, sinon 'lax'
COOKIE_SAMESITE=lax
###< Sécurité cookies ###