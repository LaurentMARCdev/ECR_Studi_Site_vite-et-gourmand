# ═══════════════════════════════════════════════════════════════
# Configuration de l'environnement — Vite & Gourmand API
# ═══════════════════════════════════════════════════════════════
# Ce fichier définit les valeurs par défaut (sans secret), à surcharger :
#   - en production (Alwaysdata) par api/.env.local, non versionné ;
#   - sous Docker par les variables d'environnement de docker-compose.yml.

APP_ENV=dev
APP_SECRET=changeme_generer_avec_openssl_rand_hex_32   # valeur réelle dans .env.local ou variable d'environnement

# ─── Base de données PostgreSQL ───────────────────────────────
# Format : postgresql://USER:PASS@HOST:PORT/DBNAME?serverVersion=X&charset=utf8
DATABASE_URL="postgresql://vitegourmand:changeme@127.0.0.1:5432/vitegourmand?serverVersion=16&charset=utf8"

# ─── MongoDB (base NoSQL — pour statistiques admin) ───────────
MONGODB_URL="mongodb://127.0.0.1:27017"
MONGODB_DB="vitegourmand_stats"

# ─── Mailer ────────────────────────────────────────────────────
# Par défaut : null://null (aucun envoi). En dev : smtp://localhost:1025 (Mailpit/Mailhog)
# En prod : SMTP réel (Brevo…), défini dans .env.local
MAILER_DSN=null://null
MAILER_FROM_ADDRESS="contact@vitegourmand.fr"
MAILER_FROM_NAME="Vite & Gourmand"

# ─── Front-end ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"

# ─── Sécurité ──────────────────────────────────────────────────
COOKIE_SECURE=false    # → true en production (HTTPS obligatoire)
COOKIE_SAMESITE=lax    # → 'strict' en prod si front sur même domaine

# ─── Contact entreprise ────────────────────────────────────────
CONTACT_EMAIL="contact@vitegourmand.fr"

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
