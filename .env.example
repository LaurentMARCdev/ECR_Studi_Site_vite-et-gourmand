# ═══════════════════════════════════════════════════════════════════
# Variables d'environnement — Vite & Gourmand (Docker)
# ───────────────────────────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs réelles :
#   cp .env.example .env
# Le fichier .env est ignoré par git (voir .gitignore)
# ═══════════════════════════════════════════════════════════════════

# ─── Environnement Symfony ──────────────────────────────────────────
APP_ENV=dev

# Générer un vrai secret avec :
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=changeme

# ─── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=vitegourmand
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vitegourmand

# ─── MongoDB ────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGODB_DB=vitegourmand_stats

# ─── Mailer ─────────────────────────────────────────────────────────
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Vite & Gourmand"

# ─── Front ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080

# ─── Démo ──────────────────────────────────────────────────────────
# Mettre à 1 pour charger les données de démo au démarrage
SEED_DEMO=0