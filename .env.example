# ═══════════════════════════════════════════════════════════════
# Variables de l'environnement Docker — Vite & Gourmand
# ═══════════════════════════════════════════════════════════════
# Copier ce fichier en .env puis remplacer chaque "changeme".
# Le fichier .env est ignoré par Git : il ne doit jamais être versionné.
#   cp .env.example .env
#   openssl rand -hex 32      # pour générer APP_SECRET

# ─── Application ──────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=changeme
APP_PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=vitegourmand
POSTGRES_USER=vitegourmand
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_ROOT_USER=vitegourmand
MONGO_ROOT_PASSWORD=changeme
MONGODB_DB=vitegourmand_stats
MONGO_PORT=27017

# ─── mongo-express (profil "outils", optionnel) ───────────────
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme
MONGO_EXPRESS_PORT=8081

# ─── E-mails ──────────────────────────────────────────────────
# null://null : les e-mails ne partent pas (développement)
MAILER_DSN=null://null

# ─── Données de démonstration ─────────────────────────────────
# 1 = charge les référentiels, plats, menus, horaires et comptes de démo
SEED_DEMO=1
# Mots de passe des comptes de démo (10 caractères min., MAJ, min., chiffre, spécial)
DEMO_PASSWORD_CLIENT=Client@Docker2026
DEMO_PASSWORD_EMPLOYE=Employe@Docker2026
DEMO_PASSWORD_ADMIN=changeme
# 1 = lance app:sync-mongo à chaque démarrage (PostgreSQL → MongoDB)
SYNC_MONGO_ON_START=1
